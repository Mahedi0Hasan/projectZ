{%- comment -%}
  lucid intro: the misted-glass wipe, the sunrise and the lens card play full screen
  over the home page, then fade away and leave the theme's own home page. It shows once
  per visitor (localStorage), never with reduced motion, and never in the theme editor.
{%- endcomment -%}
{%- unless request.design_mode -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Instrument+Serif:ital@1&display=swap">
  {{ 'lucid-embed.css' | asset_url | stylesheet_tag }}
  <div class="lucid-root" data-lucid></div>
  <script>
    (function () {
      var el = document.querySelector('[data-lucid]');
      var seen = false;
      try { seen = localStorage.getItem('lucid-intro-seen') === '1'; } catch (e) {}
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (seen || reduced) {
        el.remove();
        return;
      }
      document.documentElement.style.overflow = 'hidden';
      ['night', 'hand', 'day'].forEach(function (name) {
        var link = document.createElement('link');
        link.rel = 'preload';
        link.as = 'fetch';
        link.crossOrigin = 'anonymous';
        link.href = 'https://assets.uberdesigner.ai/lucid/' + name + '.webp';
        document.head.appendChild(link);
      });
      var script = document.createElement('script');
      script.type = 'module';
      script.src = {{ 'lucid-embed.js' | asset_url | json }};
      document.body.appendChild(script);
    })();
  </script>
{%- endunless -%}

{% schema %}
{
  "name": "lucid intro",
  "presets": [{ "name": "lucid intro" }]
}
{% endschema %}
